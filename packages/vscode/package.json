{
  "name": "ai-code-cleaner-vscode",
  "displayName": "AI Code Cleaner",
  "description": "Elimina comentarios de ruido dejados por agentes de IA, sin tocar la lógica de tu código.",
  "version": "0.0.0",
  "private": true,
  "publisher": "ai-code-cleaner",
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Other"],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "aiCodeCleaner.cleanCurrentFile",
        "title": "AI Code Cleaner: Clean Current File"
      },
      { "command": "aiCodeCleaner.previewChanges", "title": "AI Code Cleaner: Preview Changes" }
    ],
    "configuration": {
      "title": "AI Code Cleaner",
      "properties": {
        "aiCodeCleaner.liveMode.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Sugerir eliminar comentarios de ruido justo después de escribirlos."
        },
        "aiCodeCleaner.liveMode.autoApply": {
          "type": "boolean",
          "default": false,
          "description": "Eliminar automáticamente sin mostrar sugerencia (no recomendado hasta confiar en las reglas)."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:e2e": "npm run build && node ./dist/test/runTest.js"
  },
  "dependencies": {
    "@ai-code-cleaner/core": "*",
    "@ai-code-cleaner/lang-typescript": "*",
    "@ai-code-cleaner/lang-python": "*"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^3.1.0"
  }
}
