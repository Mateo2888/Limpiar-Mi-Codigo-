{
  "name": "ai-code-cleaner",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "workspaces": ["packages/core", "packages/languages/*", "packages/vscode"],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "npm run build --workspace=@ai-code-cleaner/core && npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.1"
  }
}
